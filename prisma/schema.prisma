generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String @unique
  password  String

  savedColleges SavedCollege[]
}

model College {
  id             String @id @default(cuid())
  name           String
  location       String
  fees           Int
  rating         Float
  overview       String

  avgPackage     Float
  highestPackage Float

  reviews Review[]
  savedBy SavedCollege[]
}

model Review {
  id        String @id @default(cuid())

  userName  String
  rating    Int
  comment   String

  collegeId String
  college   College @relation(fields: [collegeId], references: [id])
}

model SavedCollege {
  id        String @id @default(cuid())

  userId    String
  collegeId String

  user      User @relation(fields: [userId], references: [id])
  college   College @relation(fields: [collegeId], references: [id])
}